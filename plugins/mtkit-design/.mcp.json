{
  "mcpServers": {
    "mtkit_catalog": {
      "command": "node",
      "args": ["dist/catalog.cjs"],
      "cwd": ".",
      "startup_timeout_sec": 30
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "startup_timeout_sec": 30
    },
    "shadcn": {
      "command": "npx",
      "args": ["--yes", "shadcn@4.23.0", "mcp"],
      "startup_timeout_sec": 120
    },
    "playwright": {
      "command": "npx",
      "args": ["--yes", "@playwright/mcp@0.0.85", "--headless", "--isolated"],
      "startup_timeout_sec": 120
    }
  }
}
